# Copy to cortana.env ON THE PI (~/wire-pod/cortana.env, chmod 600). Never commit the real file.
# Separate from Vector's .env on purpose: ./use-llm.sh switches Vector's brain, not Cortana's.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
FORCE_MODEL=claude-haiku-5-5
LLM_EFFORT=low                 # voice turns: thinking is always on, effort is the speed dial
LLM_BACKGROUND_EFFORT=medium   # nightly memory/summary jobs
LLM_FALLBACKS=                 # Haiku has no server-side refusal fallback

# Web search (Tavily remote MCP) and Home Assistant (its MCP Server integration). Unset = off.
TAVILY_API_KEY=tvly-...
HA_TOKEN=...
# HA_MCP_URL=http://127.0.0.1:8123/api/mcp

AGENT_LOCATION=London, UK

# The Pi Zero satellite (wyoming-satellite). Empty = text only (/chat on 127.0.0.1:8092).
SATELLITE_URI=tcp://192.168.1.96:10700

# All optional:
# ASSISTANT_NAME=Cortana
# FOLLOW_UP_MODE=questions     # questions / always / never: listen again without the wake word
# VAD_SILENCE_S=0.8            # quiet after speech that ends the request
# VAD_START_TIMEOUT_S=6        # nobody spoke after the chime
# VAD_MAX_S=15
# VAD_MODE=2                   # 0 lenient .. 3 strict (noisy room: 3)
# PIPER_VOICE=                 # empty = the piper container's default voice
# WHISPER_TIMEOUT=10
# THREAD_IDLE_MINUTES=0        # 0 = one continuous conversation (rolling summary)
# HISTORY_TOKENS=16000  KEEP_TOKENS=8000  NIGHT_KEEP_TOKENS=2500  NIGHTLY_AT=03:30
# TURN_BUDGET_S=14  TURN_HARD_LIMIT_S=60  TURN_LOCK_WAIT_S=20
# REMINDERS_MAX=20  REMINDER_RETRY_MIN=15
# MEMORY_BACKEND=json          # kumiho: shared memory with Vector (not set up yet)
# AGENT_DEBUG=1                # log tool results

# Long-term memory on the NUC (beliefs-api), her own tenant. Unset = notes-only memory.
# Token: on the NUC in ~/beliefs-api/data/cortana-pi5.token
# BELIEFS_URL=http://192.168.1.118:8100
# BELIEFS_TOKEN=

# A2A: her door for other agents (port 8096; off unless A2A_TOKEN is set) and the other
# assistant she can ask (ask_vector). PEER_A2A_TOKEN is Vector's A2A_TOKEN.
# A2A_TOKEN=
# A2A_PUBLIC_URL=http://192.168.1.39:8096
# PEER_NAME=Vector
# PEER_A2A_URL=http://127.0.0.1:8095
# PEER_A2A_TOKEN=

# YouTube Music (agent_core/ytmusic.py): on by default, no key needed. Catalogue songs play
# without a sign-in; John's playlists and liked songs need one, made on the laptop with
# deploy/pi/ytmusic-login.py (it writes ~/wire-pod/cortana-data/ytmusic/cookies.txt).
# The stream port and address are set in compose.yaml.
# YTMUSIC_ENABLED=0            # turn it off: the NAS library only
