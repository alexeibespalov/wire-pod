# Copy to .env ON THE PI (~/wire-pod/.env, chmod 600). Never commit the real file.

# Brain profiles: keep one file per provider on the Pi (.env.qwen, .env.claude) and switch
# with ./use-llm.sh <profile>, which copies it to .env and recreates vector-agent.

# --- Profile "qwen": any OpenAI-compatible endpoint (LLM_PROVIDER=openai is the default)
UPSTREAM_BASE=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
UPSTREAM_KEY=sk-...
FORCE_MODEL=qwen3.6-flash

# --- Profile "claude": the Anthropic API (instead of the three lines above)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# FORCE_MODEL=claude-opus-5-5     # default for this provider
# LLM_EFFORT=low                  # voice turns: thinking is always on, effort is the speed dial
# LLM_BACKGROUND_EFFORT=medium    # sleep jobs, practice
# LLM_FALLBACKS=default           # server-side refusal fallbacks ("" to turn off)

# 1 = log full prompts and responses in `docker logs kg-proxy` (contains conversation text)
PROXY_DEBUG=0

# Web search via Tavily's remote MCP (sent as Authorization header). Unset = no web search.
TAVILY_API_KEY=tvly-...

# Where Vector lives (default place for weather/local questions)
AGENT_LOCATION=London, UK

# vector-agent extras (all optional)
# TAVILY_TOOLS=tavily_search,tavily_extract
# TAVILY_DEFAULTS={"search_depth": "basic", "max_results": 5}
# AGENT_DEBUG=1              # log tool calls (PROXY_DEBUG=1 also works)
# LLM_EXTRA_BODY={"enable_thinking": false}
# LLM_TEMPERATURE=0.8
# THREAD_IDLE_MINUTES=0       # 0 = one continuous conversation; N = start fresh after N quiet minutes
# HISTORY_TOKENS=16000        # past this, old messages are folded into a rolling summary
# KEEP_TOKENS=8000            # recent conversation kept word-for-word after folding
# TURN_HARD_LIMIT_S=60        # a turn still running after this is cancelled (never wedges him)
# TURN_LOCK_WAIT_S=20         # a new request waits this long for the previous turn, then says "busy"
# FOLLOW_UP_MODE=always      # always / questions / never: keep listening after replies

# A2A (Agent2Agent): other agents can talk to Vector on port 8095 (LAN + tailnet).
# Disabled unless A2A_TOKEN is set. Generate one with: openssl rand -hex 32
A2A_TOKEN=
A2A_PUBLIC_URL=http://<pi-lan-or-tailscale-ip>:8095
# A2A_ALLOW_CAMERA=0          # 1 = remote agents may use Vector's camera (look)

# Exploration photos (agent snaps the camera when his own exploring meets an obstacle/object)
# EXPLORE_CAPTURE=1             # 0 = off by default (can also be toggled by voice)
# EXPLORE_PROX_MM=110           # "object close" threshold
# EXPLORE_PROX_MIN_QUALITY=0.02 # proximity signal quality gate (idle noise is ~0.01)
# EXPLORE_PROX_COOLDOWN_S=20
# EXPLORE_OBJECT_COOLDOWN_S=60  # per object (charger/cube/custom)
# EXPLORE_MIN_INTERVAL_S=6      # between any two photos
# EXPLORE_MAX_PER_HOUR=60
# EXPLORE_MAX_PHOTOS=500        # disk cap: newest N kept (~30-60 KB each)
# EXPLORE_MOVING_GRACE_S=8

# Sleep routine (chores while he sleeps: VLM analysis of exploration photos)
# SLEEP_ROUTINE=1
# SLEEP_CALM_SECONDS=120        # calm power mode (WireOS sleep) this long = asleep
# SLEEP_QUIET_MINUTES=10        # ...and nobody talked to him for this long
# SLEEP_FALLBACK=1              # on charger + idle (+ night hours) also counts as asleep
# SLEEP_FALLBACK_IDLE_MINUTES=30
# SLEEP_FALLBACK_NIGHT_ONLY=1
# SLEEP_NIGHT_START=22          # local hours (AGENT_TZ)
# SLEEP_NIGHT_END=7
# SLEEP_SESSION_BUDGET_S=1200
# SLEEP_MIN_INTERVAL_MIN=20     # between sessions
# SLEEP_VLM_BATCH=25            # photos analysed per session
# SLEEP_VLM_DELAY_S=2
# SLEEP_VLM_MAX_ATTEMPTS=3

# Map understanding (all optional)
# NAVMAP_FEED_SEC=5           # min seconds between nav map pushes (robot only sends when the map changes)
# FINDINGS_HOURS=24           # exploration photo findings: how far back
# FINDINGS_MAX=8              # exploration photo findings: max photos per answer

# Known places (which surface is he on? decided while he sleeps; see vector-agent/app/places.py)
# PLACE_MIN_PHOTOS=3           # described exploration photos needed per stay
# PLACE_GROUP_GAP_H=3          # a gap this long splits a stay
# PLACE_MATCH_CONF=0.75        # >= this: it's that known place
# PLACE_PROBABLE_CONF=0.5      # >= this: probably that place (never creates a new one)
# PLACE_CONFIRM_SIGHTINGS=2    # provisional place confirmed after this many stays (or when named)
# PLACE_PROVISIONAL_DAYS=7     # unconfirmed one-off places expire
# PLACES_MAX=20

# Body / maneuvers (vector-agent/app/body.py) - safety limits for movement the LLM builds itself
# BODY_TRANSPORT=grpc          # grpc (precise, verified) | http (fallback, overshoots)
# BODY_LEASH_MM=400            # abort a maneuver this far from where it started
# BODY_MAX_SPEED_MMPS=120      # BODY_FAST_SPEED_MMPS=220 with fast=true
# BODY_MAX_DRIVE_MM=300        # per drive step; BODY_MAX_MANEUVER_S=60 per run
# BODY_IDLE_PRACTICE=0         # 1 = practise least reliable maneuver when idle off the charger
# Scheduled actions / routines (vector-agent/app/scheduler.py)
# SCHEDULE_MAX_ACTIVE=5  SCHEDULE_MIN_EVERY_S=5  SCHEDULE_DEFAULT_MINUTES=30  SCHEDULE_MAX_MINUTES=180
# SCHEDULE_SPEECH_GAP_S=20     # min seconds between background remarks per schedule
# SCHEDULE_CAMERA_PER_HOUR=400 # background camera looks (vision model calls) per hour
