# Copy to .env ON THE PI (~/wire-pod/.env, chmod 600). Never commit the real file.

# OpenAI-compatible LLM endpoint the proxy/agent talks to
UPSTREAM_BASE=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
UPSTREAM_KEY=sk-...
FORCE_MODEL=qwen3.6-flash

# 1 = log full prompts and responses in `docker logs kg-proxy` (contains conversation text)
PROXY_DEBUG=0

# Web search via Tavily's remote MCP (sent as Authorization header). Unset = no web search.
TAVILY_API_KEY=tvly-...

# Where Vector lives (default place for weather/local questions)
AGENT_LOCATION=London, UK

# vector-agent extras (all optional)
# TAVILY_TOOLS=tavily_search,tavily_extract
# TAVILY_DEFAULTS={"search_depth": "basic", "max_results": 5}
# AGENT_DEBUG=1              # log tool calls (PROXY_DEBUG=1 also works)
# LLM_EXTRA_BODY={"enable_thinking": false}
# LLM_TEMPERATURE=0.8
# THREAD_IDLE_MINUTES=10      # start a fresh conversation after this much silence
# MAX_HISTORY_MESSAGES=40
# FOLLOW_UP_MODE=always      # always / questions / never: keep listening after replies

# A2A (Agent2Agent): other agents can talk to Vector on port 8095 (LAN + tailnet).
# Disabled unless A2A_TOKEN is set. Generate one with: openssl rand -hex 32
A2A_TOKEN=
A2A_PUBLIC_URL=http://<pi-lan-or-tailscale-ip>:8095
# A2A_ALLOW_CAMERA=0          # 1 = remote agents may use Vector's camera (look)
