# Written by deploy/pizero/setup.sh (Cortana): the dashboard on the 3.5" SPI screen.
# cage (a one-window Wayland kiosk) on tty1, drawing with pixman onto the ili9486 panel;
# -d: no title bar on foot (it cost the screen its 15th row);
# foot inside it; the Textual app inside foot. Taps on the touch panel reach the app as clicks.
[Unit]
Description=Cortana's screen (VFD dashboard on the SPI panel)
After=systemd-user-sessions.service network-online.target mpd.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=john
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
EnvironmentFile=/etc/cortana-dash.env
EnvironmentFile=-/etc/default/cortana-speaker
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WLR_DRM_DEVICES=/dev/dri/by-path/platform-3f204000.spi-cs-0-card
Environment=WLR_RENDERER=pixman
Environment=XCURSOR_PATH=/opt/cortana-dash/cursors
Environment=XCURSOR_THEME=blank
Environment=PYTHONPATH=/opt/cortana-dash
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/cortana-dash
ExecStart=/usr/bin/cage -d -s -- /usr/bin/foot -c /opt/cortana-dash/foot.ini /opt/cortana-dash/venv/bin/python -m cortana_dash
Restart=always
RestartSec=3
# the wake word comes first: the screen gets what's left
Nice=10
MemoryHigh=110M
MemoryMax=150M

[Install]
WantedBy=multi-user.target
