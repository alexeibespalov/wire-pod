+def _drop_targets(texts, target_phrases):
+    """(Cortana training) With several target phrases ("cortana", "hey cortana"), partial
+    adversarial phrases can be a target itself ("cortana"): never train those as negatives.
+    Drops any text containing a word shared by every target phrase."""
+    key = set.intersection(*[set(t.lower().split()) for t in target_phrases])
+    targets = {t.lower().strip() for t in target_phrases}
+    kept = [t for t in texts if t.lower().strip() not in targets and not key & set(t.lower().split())]
+    logging.info(f"adversarial texts: dropped {len(texts) - len(kept)} containing {sorted(key)}")
+    return kept
+
